POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=change-me
DATABASE_URL=jdbc:postgresql://localhost:5432/jobpilot
JOBPILOT_VERSION=unknown
BUILD_COMMIT=unknown
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_POLL_TIMEOUT=15s
TELEGRAM_POLL_DELAY=2s
TELEGRAM_POLL_LIMIT=50
TELEGRAM_MAX_UPDATE_FAILURES=3
TELEGRAM_DISCARD_PENDING_ON_FIRST_START=true
# Private Telegram review bot. Disabled by default; no token is required while off.
# Add the real token and your numeric private chat ID only to your local .env.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MATCH_NOTIFICATIONS_ENABLED=true
TELEGRAM_REVIEW_DIGEST_ENABLED=true
TELEGRAM_MAX_JOBS_PER_MESSAGE=5
TELEGRAM_MAX_NOTE_LENGTH=500
TELEGRAM_POLLING_TIMEOUT_SECONDS=15
# Comma-separated public ATS tenants. src/main/resources/application-development.yml
# holds the audited 53-tenant registry these five variables mirror;
# docs/source-expansion-audit.md records the evidence for each entry.
GREENHOUSE_BOARD_TOKENS=gitlab,grafanalabs,elastic,cloudflare,datadog,canonical,twilio,yesenergy,thepacgroup,algolia,scbitdefendersrl,showpad
LEVER_COMPANY_IDS=swissborg,collabora,swapcard,whereby,weloglobal,veeva
ASHBY_BOARD_NAMES=Ashby,langchain,n8n,enode,linear,supabase,posthog,gitbook,deepgram,temporal,clickhouse,airbyte,render,incident,cursor,notion,cohere,elevenlabs,qonto,attio,pleo,runway,uipath
RECRUITEE_COMPANY_IDS=transperfect,tether,auditdata,moneyhash,veocareers,aidigital,almavivadebelgique
# Verified by the Phase 3.3D and 3.3F controlled live validations;
# see docs/smartrecruiters-live-validation.md.
SMARTRECRUITERS_COMPANY_IDENTIFIERS=BoschGroup,AECOM2,Ubisoft2,Endava,Gameloft
# Workday career sites as tenant:shard:careerSite (comma separated). Empty by default.
# Phase 4B.2A validated these three; activate only after a controlled validation run:
#   db:wd3:DBWebsite,nxp:wd3:careers,lseg:wd3:Careers
# See docs/workday-provider-design.md for the safety limits and per-tenant evidence.
WORKDAY_CAREER_SITES=
JOBPILOT_TARGET_CITY=Bucharest
JOBPILOT_TARGET_COUNTRY=Romania
JOBPILOT_INCLUDE_ILFOV=false
JOBPILOT_ACCEPT_BUCHAREST_ONSITE=true
JOBPILOT_ACCEPT_BUCHAREST_HYBRID=true
JOBPILOT_ACCEPT_BUCHAREST_REMOTE=true
JOBPILOT_ACCEPT_REMOTE_FROM_ROMANIA=true
JOBPILOT_REJECT_UNKNOWN_REMOTE_SCOPE=true
JOBPILOT_ACCEPTED_REMOTE_REGIONS=ROMANIA,EU,EEA,EUROPE,EMEA,WORLDWIDE
MANUAL_URL_CONNECT_TIMEOUT=5s
MANUAL_URL_RESPONSE_TIMEOUT=15s
MANUAL_URL_MAX_REDIRECTS=3
JOBPILOT_HTTP_MAX_RESPONSE_BYTES=10485760
MANUAL_URL_MAX_RESPONSE_BYTES=1048576
MANUAL_URL_MAX_TITLE_LENGTH=500
MANUAL_URL_MAX_DESCRIPTION_LENGTH=100000
LLM_ENABLED=false
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONNECT_TIMEOUT=5s
LLM_RESPONSE_TIMEOUT=60s
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_RETRIES=1
LLM_REQUEST_BUDGET_USD=
LLM_DAILY_BUDGET_USD=
LLM_MONTHLY_BUDGET_USD=
LLM_INPUT_COST_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_PER_MILLION_TOKENS=
DOCUMENTS_ENABLED=false
DOCUMENT_STORAGE_ROOT=./data/documents
DOCUMENT_MAX_DOCX_BYTES=2097152
DOCUMENT_MAX_PDF_BYTES=2097152
DOCUMENT_RESUME_TEMPLATE_VERSION=resume-v1
DOCUMENT_COVER_NOTE_TEMPLATE_VERSION=cover-note-v1
DOCUMENT_RENDERER_VERSION=apache-v1
DOCUMENT_MAX_PREVIEW_CHARACTERS=4000
DOCUMENT_STALE_AFTER=10m
DOCUMENT_CONTACT_CACHE_HMAC_KEY=
DOCUMENT_CONTACT_EMAIL=
DOCUMENT_CONTACT_PHONE=
DOCUMENT_CONTACT_GITHUB_URL=
DOCUMENT_CONTACT_LINKEDIN_URL=
DOCUMENT_CONTACT_PORTFOLIO_URL=
MAINTENANCE_ENABLED=false
MAINTENANCE_INTERVAL=15m
MAINTENANCE_MAX_ITEMS_PER_RUN=100
MAINTENANCE_MAX_DURATION_PER_RUN=30s
MAINTENANCE_ORPHAN_GRACE_PERIOD=1h
SCRAPER_WORKER_ENABLED=false
SCRAPER_WORKER_BASE_URL=http://scraper-worker:3000
SCRAPER_WORKER_SHARED_SECRET=
SCRAPER_WORKER_CONNECT_TIMEOUT=5s
