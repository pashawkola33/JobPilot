# JobPilot production environment template — Azure Linux VM.
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Copy this file to /opt/jobpilot/.env on the server and fill in the MANDATORY
# block. Every placeholder below is fake. Never copy values out of a running
# host's .env by hand-editing this template, and never commit a filled-in copy.
#
# Compose reads /opt/jobpilot/.env automatically from the working directory:
#   docker compose -f docker-compose.prod.yml up -d
#
# Full procedure: docs/server-migration-runbook.md


# ---------------------------------------------------------------------------
# MANDATORY — the stack refuses to start if any of these is unset or empty
# ---------------------------------------------------------------------------

# Immutable commit SHA published by .github/workflows/ci.yml. Never a mutable
# tag: pinning to a branch name makes a restart silently change the running code.
JOBPILOT_IMAGE_TAG=0000000000000000000000000000000000000000

POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
# Generate on the server, e.g. `openssl rand -base64 30`. Must match the value the
# volume was initialised with; changing it later does not change the stored role.
POSTGRES_PASSWORD=replace-with-a-generated-secret


# ---------------------------------------------------------------------------
# OPTIONAL — safe defaults apply when omitted. Values here are the defaults.
# ---------------------------------------------------------------------------

# Host loopback port. Reached with `ssh -N -L 8080:127.0.0.1:8080 jobpilot@<vm>`.
PORT=8080

# Ingestion. Keep false until the cutover step confirms the Mac app is stopped.
# Two schedulers running at once double-fetch the same tenants.
JOBPILOT_SCHEDULING_ENABLED=false
JOB_FETCH_CRON=0 0 */6 * * *
DAILY_DIGEST_CRON=0 0 9 * * *
STALE_DAYS=30

# Telegram. Keep both false until cutover: two long pollers sharing one bot token
# steal each other's updates. Token and chat IDs stay empty while disabled.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_MATCH_NOTIFICATIONS_ENABLED=true
TELEGRAM_REVIEW_DIGEST_ENABLED=true
# Drops the backlog accumulated while the bot was down, on first start only.
TELEGRAM_DISCARD_PENDING_ON_FIRST_START=true

# Public ATS tenant registry. Copy the audited lists from .env.example; see
# docs/source-expansion-audit.md for the evidence behind each entry. Empty means
# that provider fetches nothing.
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_IDS=
ASHBY_BOARD_NAMES=
RECRUITEE_COMPANY_IDS=
SMARTRECRUITERS_COMPANY_IDENTIFIERS=
# tenant:shard:careerSite. Activate only after a controlled validation run.
WORKDAY_CAREER_SITES=

# Post-migration phases. LLM activation is a separate approved phase with its own
# budget guards and must not be combined with a migration window.
LLM_ENABLED=false
SCRAPER_WORKER_ENABLED=false
DOCUMENTS_ENABLED=false
MAINTENANCE_ENABLED=false

# Build identity is baked into the image and served by /health. Do NOT set
# JOBPILOT_VERSION or BUILD_COMMIT here — any value overrides the real one.


# ---------------------------------------------------------------------------
# DANGEROUS — one-shot guarded commands. Leave exactly as written.
# ---------------------------------------------------------------------------
#
# Mode and write capability are independently default-off, and both must be
# turned on for any row to change. Do not enable them in this file: the guards
# (expected counts, plan fingerprint, confirmation token) are computed from a
# preview taken immediately beforehand and are valid for minutes, so they belong
# on a temporary one-shot process only:
#
#   docker compose -f docker-compose.prod.yml run --rm --no-deps \
#     -e SPRING_MAIN_WEB_APPLICATION_TYPE=none \
#     -e JOBPILOT_SCHEDULING_ENABLED=false \
#     -e TELEGRAM_BOT_ENABLED=false -e TELEGRAM_COMMANDS_ENABLED=false \
#     -e JOBPILOT_SCORE_RESCORE_COMMAND_MODE=PREVIEW \
#     app
#
# A stale fingerprint or count left in this file would arm a write on the next
# ordinary restart. That is why every one of these stays off here.

JOBPILOT_SCORE_RESCORE_PREVIEW_ENABLED=false
JOBPILOT_SCORE_RESCORE_COMMAND_MODE=OFF
JOBPILOT_SCORE_RESCORE_WRITE_ENABLED=false
JOBPILOT_SOURCE_LOG_CLEANUP_MODE=OFF
JOBPILOT_SOURCE_LOG_CLEANUP_WRITE_ENABLED=false
